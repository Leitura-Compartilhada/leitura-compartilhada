{
  "name": "@leitura/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Getulio Vagner",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "backfill:metadata": "tsx --env-file-if-exists=../../.env src/scripts/backfill-metadata.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "@leitura/db": "workspace:*",
    "@leitura/shared": "workspace:*",
    "@leitura/storage": "workspace:*",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^6.0.0",
    "pg-boss": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
