# ATENÇÃO: copie este arquivo para .env SÓ se ainda não existir um .env (cp -n). Copiar por cima
# apaga a configuração do seu servidor (URLs, segredo de login, cadastro).

# Postgres (docker compose up -d postgres)
DATABASE_URL=postgres://leitura:leitura@localhost:5432/leitura

# API
API_PORT=3000
# Interface em que a API escuta. Padrão: só esta máquina; o acesso de fora passa pelo `tailscale serve`.
# API_HOST=127.0.0.1
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
BETTER_AUTH_SECRET=troque-por-uma-string-aleatoria-de-32-chars-ou-mais

# Armazenamento de arquivos (driver local em dev)
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# Worker
# Em produção, caminho absoluto do ebook-convert (com só o nome o sistema o procura primeiro na pasta de trabalho).
CALIBRE_BIN=ebook-convert
# Tempo máximo de uma conversão, em ms. API e worker leem o mesmo valor (padrão 300000 = 5 min).
CONVERT_TIMEOUT_MS=300000
ANTHROPIC_API_KEY=
PDF_AI_MODEL=claude-sonnet-5-5

# Cadastro de usuários. Crie a sua conta e depois desligue (false).
# Sem a variável: aberto em desenvolvimento e fechado quando NODE_ENV=production.
ALLOW_SIGNUP=true

# Pasta do web já buildado; se existir, a API o serve (uma origem só). Relativa à raiz do repositório.
WEB_DIST=./apps/web/dist

# Em produção, API_URL e WEB_URL são a URL pública (ex.: https://pc.tailnet.ts.net) e o
# BETTER_AUTH_SECRET precisa ser próprio: a API não inicia com o padrão em produção nem quando
# API_URL/WEB_URL não apontam para esta máquina.
# NODE_ENV=production

# Banco usado pelos testes de integração (precisa terminar em _test; é criado se faltar).
TEST_DATABASE_URL=postgres://leitura:leitura@localhost:5432/leitura_test
